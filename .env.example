# ------------------------------------------------------------------ telegram
# Token from @BotFather. Required.
BOT_TOKEN=

# Your numeric Telegram user id (owner). Get it from @userinfobot.
OWNER_ID=0

# Extra admins, comma separated.
ADMIN_IDS=

# Shown in headers/footers.
BOT_NAME=Downloader
SUPPORT_USERNAME=

# polling (default) or webhook
BOT_MODE=polling
# Required in webhook mode, e.g. https://bot.example.com
WEBHOOK_URL=
WEBHOOK_PATH=/telegram/webhook
# Random string; Telegram sends it back in X-Telegram-Bot-Api-Secret-Token.
WEBHOOK_SECRET=
HOST=0.0.0.0
PORT=8080
DROP_PENDING_UPDATES=false
REGISTER_COMMANDS=true

# ----------------------------------------------------------------- behaviour
# Delete the user's link message after accepting it (groups only, best effort).
DELETE_INCOMING_LINKS=true
# How many links to handle per message.
MAX_LINKS_PER_MESSAGE=1
# Post a small "queued / fetching / processing" message while working.
SEND_STATUS_MESSAGE=true

# Bot API limits (change only if you run a local Bot API server).
TELEGRAM_URL_PHOTO_LIMIT=5242880
TELEGRAM_URL_VIDEO_LIMIT=20971520
TELEGRAM_UPLOAD_LIMIT=52428800
ALBUM_CHUNK_SIZE=10

# --------------------------------------------------------------------- queues
# Per-platform fetch (metadata) queue defaults.
FETCH_QUEUE_SIZE=64
FETCH_CONCURRENCY=2
FETCH_RATE_PER_SECOND=1.0

# Processing queue: RAM budget for downloads + ffmpeg muxing.
PROCESSING_QUEUE_SIZE=32
PROCESSING_CONCURRENCY=1
PROCESSING_MAX_RAM_BYTES=2147483648
PROCESSING_RAM_FACTOR=2.5
PROCESSING_DEFAULT_ESTIMATE_BYTES=134217728

# ----------------------------------------------------------------- downloader
DOWNLOAD_DIR=data/downloads
TEMP_DIR=data/tmp
PROXY=
# Optional Netscape cookie file (for age-restricted YouTube / login-only tweets).
COOKIES_FILE=
# Instagram: path to an instaloader session file. Strongly recommended -
# anonymous Instagram requests are rate limited after a handful of calls with
# HTTP 401 "Please wait a few minutes before you try again". Create it once on
# the host with:  instaloader --login=<your_account>
INSTAGRAM_SESSION_FILE=
REQUEST_TIMEOUT=30

# ------------------------------------------------------------------- database
DATABASE_URL=sqlite+aiosqlite:///./data/bot.db
AUTO_MIGRATE=true
DB_ECHO=false

# ----------------------------------------------------------------------- misc
LOG_LEVEL=INFO
BROADCAST_RATE_PER_SECOND=20
